+    public void hunterMarkDirect(final boolean onlineAuthenticated) {
+        this.hunterConnectionSource = org.huntercore.api.network.HunterConnectionSource.DIRECT;
+        this.hunterProxyId = "";
+        this.hunterNetworkId = "";
+        this.hunterOnlineAuthenticated = onlineAuthenticated;
+    }
+
+    public void hunterMarkProxy(final org.huntercore.api.network.HunterConnectionSource source, final org.huntercore.network.HunterProxyNode node) {
+        if (!source.proxied()) {
+            throw new IllegalArgumentException("Proxy connection source required");
+        }
+        this.hunterConnectionSource = source;
+        this.hunterProxyId = node.id();
+        this.hunterNetworkId = node.networkId();
+        this.hunterOnlineAuthenticated = node.onlineAuthenticated();
+    }
+
+    @Override
+    public org.huntercore.api.network.HunterConnectionSource hunterConnectionSource() {
+        return this.hunterConnectionSource;
+    }
+
