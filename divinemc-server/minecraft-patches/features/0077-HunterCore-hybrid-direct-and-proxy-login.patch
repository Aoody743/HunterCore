     private void handleCustomQueryPacket0(final ServerboundCustomQueryAnswerPacket packet) {
-        if (io.papermc.paper.configuration.GlobalConfiguration.get().proxies.velocity.enabled && packet.transactionId() == this.velocityLoginMessageId) {
+        if (this.velocityLoginMessageId != -1 && packet.transactionId() == this.velocityLoginMessageId) {
             ServerboundCustomQueryAnswerPacket.QueryAnswerPayload payload = (ServerboundCustomQueryAnswerPacket.QueryAnswerPayload)packet.payload();
             if (payload == null) {
-                this.disconnect("This server requires you to connect with Velocity.");
+                this.hunterBeginDirectLogin();
                 return;
             }
 
             net.minecraft.network.FriendlyByteBuf buf = payload.buffer;
-            if (!com.destroystokyo.paper.proxy.VelocityProxy.checkIntegrity(buf)) {
+            if (buf.readableBytes() < 32) {
+                this.disconnect("Unable to verify player details");
+                return;
+            }
+            final byte[] signature = new byte[32];
+            buf.readBytes(signature);
+            final byte[] signedData = new byte[buf.readableBytes()];
+            buf.getBytes(buf.readerIndex(), signedData);
+            final java.net.SocketAddress rawAddress = this.connection.channel.remoteAddress();
+            java.util.Optional<org.huntercore.network.HunterProxyNode> proxyNode = org.huntercore.network.HunterProxyRegistry.verifyVelocity(rawAddress, signature, signedData);
+            if (proxyNode.isEmpty() && !org.huntercore.network.HunterProxyRegistry.configured(org.huntercore.network.HunterProxyType.VELOCITY)
+                && io.papermc.paper.configuration.GlobalConfiguration.get().proxies.velocity.enabled
+                && org.huntercore.network.HunterProxyRegistry.verifyHmac(io.papermc.paper.configuration.GlobalConfiguration.get().proxies.velocity.secret, signature, signedData)) {
+                proxyNode = java.util.Optional.of(org.huntercore.network.HunterProxyNode.legacy(
+                    "paper-velocity",
+                    org.huntercore.network.HunterProxyType.VELOCITY,
+                    io.papermc.paper.configuration.GlobalConfiguration.get().proxies.velocity.secret,
+                    io.papermc.paper.configuration.GlobalConfiguration.get().proxies.velocity.onlineMode
+                ));
+            }
+            if (proxyNode.isEmpty()) {
                 this.disconnect("Unable to verify player details");
                 return;
             }
@@ -425,6 +461,7 @@ public class ServerLoginPacketListenerImpl implements ServerLoginPacketListener,
             this.connection.address = new java.net.InetSocketAddress(com.destroystokyo.paper.proxy.VelocityProxy.readAddress(buf), port);
 
