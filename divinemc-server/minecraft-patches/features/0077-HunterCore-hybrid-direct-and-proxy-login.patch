+        return this.hunterProxyId;
+    }
+
+    @Override
+    public String hunterNetworkId() {
+        return this.hunterNetworkId;
+    }
+
+    @Override
+    public boolean hunterOnlineAuthenticated() {
+        return this.hunterOnlineAuthenticated;
+    }
